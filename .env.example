# API Gateway Configuration

# Server
HOST=0.0.0.0
PORT=8080
DEBUG=true

# Database (PostgreSQL - đã đồng bộ sang postgres)
DATABASE_URL=postgresql+asyncpg://ocr_cuong:ocr_cuong@localhost:5432/api_gateway_db

# JWT Authentication
SECRET_KEY=speedmaint-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RAGAnything Service — rag-service chạy port 8006
RAG_SERVICE_URL=http://localhost:8006

# Analytics/Predict Service
ANALYTICS_SERVICE_URL=http://localhost:8007

# Water Forecast API
WATER_API_URL=http://10.0.0.62:8000

# CORS — cho phép UI dev
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=104857600
